# Only the sources live in git. scripts/render.sh rebuilds everything else:
# the cards (gen-assets.ts), the sheet (build_sheet.py), the compositions and hub
# (build_videos.py), then the renders and docs/*.webp.

# Generated from the mods' code
assets/cards/
compositions/
index.html
storyboard.html

# Render output and scratch
renders/
snapshots/
.debug/
.thumbnails/
__pycache__/

# HyperFrames' local state: preview session, remembered preferences
.hyperframes/
.media/

# HyperFrames' scaffold notes for coding agents (regenerated by `hyperframes init`)
AGENTS.md
CLAUDE.md
